# mock | filesystem | active | cli | rest | tool
SCANNER_MODE=mock

# Mock mode
SCANNER_MOCK_DATA_PATH=data/mock_scan_result.json

# Filesystem mode: read-only parent of active-scan-* directories
SCANNER_RESULTS_DIR=

# Active mode: run the repository scanner with an endpoint scope by default
# (same PHP path, query/mode variations; use single or crawl to override).
# Repository root. The sibling scanner is resolved as ../ai_scanner.
SCANNER_PROJECT_DIR=..
SCANNER_ANALYSIS_MODE=auto
SCANNER_SCAN_MODE=endpoint
SCANNER_COOKIE=

# Reserved integration settings (no command/request is executed yet)
SCANNER_CLI_COMMAND=
SCANNER_WORKING_DIR=
SCANNER_CLI_TIMEOUT_SECONDS=300
SCANNER_API_BASE_URL=
SCANNER_API_KEY=
SCANNER_REQUEST_TIMEOUT_SECONDS=30

# Dashboard-only settings
SCANNER_MAX_UPLOAD_MB=20
# PHP built-in server example: php -S 127.0.0.1:8079 -t ../server
SCANNER_DEFAULT_TARGET_URL=http://127.0.0.1:8079/login.php
